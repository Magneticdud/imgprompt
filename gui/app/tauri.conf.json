{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "imgprompt",
  "version": "0.1.0",
  "identifier": "dev.imgprompt.gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "imgprompt",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
